        "name": "Get State from Context",
        "func": "// استرجاع البيانات من الذاكرة\nlet currentState = global.get('systemState') || {\n  \"status\": \"No data received yet\",\n  \"mode\": \"UNKNOWN\"\n};\n\nmsg.payload = {\n  \"success\": true,\n  \"timestamp\": new Date().toISOString(),\n  \"data\": currentState\n};\n\nreturn msg;",
