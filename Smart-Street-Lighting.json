        "name": "function 2",
        "func": "// let distance = msg.payload.distance || 0;\n// let motion = msg.payload.motion || 0;\n\n// // 1. تجهيز استعلام قاعدة البيانات\n// let sqlQuery = `INSERT INTO logs (motion_detected, distance_cm, timestamp) VALUES (${motion}, ${distance}, DATETIME('now'))`;\n// let dbMsg = { topic: sqlQuery };\n\n// // 2. تجهيز رسالة التليجرام (شرط الحركة = 1 والمسافة < 20)\n// let telegramMsg = null;\n\n// if (Number(motion) === 1 && Number(distance) < 20) {\n//     telegramMsg = {\n//         payload: {\n//             chatId: 1787589713, // رقم حسابك الشخصي\n//             type: 'message',\n//             content: `🚨 تنبيه حركة من النظام:\\nالمسافة: ${distance} سم`\n//         }\n//     };\n// }\n\n// // // إرجاع المخرجين: المخرج 1 للتليجرام، والمخرج 2 لقاعدة البيانات\n// return [telegramMsg, dbMsg];\n// let payload = msg.payload || {};\n// let distance = Number(payload.distance || 0);\n// let motion = Number(payload.motion || 0);\n\n// let telegramMsg = null;\n\n// if (motion === 1 && distance < 20) {\n//     telegramMsg = {\n//         payload: {\n//             chatId: 6380128325, // تم التحديث إلى ID حسابك الفعّال\n//             type: 'message',\n//             content: `🚨 تنبيه حركة من النظام:\\nالمسافة: ${distance} سم`\n//         }\n//     };\n// }\n\n// let dbMsg = {\n//     topic: `INSERT INTO logs (motion_detected, distance_cm, timestamp) VALUES (${motion}, ${distance}, DATETIME('now'))`\n// };\n\n// return [telegramMsg, dbMsg];\nlet payload = msg.payload || {};\n\n// تحويل النص إلى JSON إذا وصل البيانات على شكل String\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch(e) { return null; }\n}\n\nlet distance = Number(payload.distance || 0);\nlet motion = Number(payload.motion || 0);\n\n// 1. تجهيز رسالة التليجرام (ترسل عند الحركة أو الاقتراب أقل من 30 سم)\nlet telegramMsg = null;\nif (motion === 1 || (distance > 0 && distance <= 30)) {\n    telegramMsg = {\n        payload: {\n            chatId: 6380128325,\n            type: 'message',\n            content: `🚨 **تنبيه حركة من النظام:**\\nالمسافة: ${distance} سم\\nالحركة: ${motion === 1 ? 'مكشوفة 🚶' : 'غير مكشوفة'}`\n        }\n    };\n}\n\n// 2. تجهيز استعلام الحفظ في قاعدة البيانات\nlet dbMsg = {\n    topic: `INSERT INTO logs (motion_detected, distance_cm, timestamp) VALUES (${motion}, ${distance}, DATETIME('now'))`\n};\n\n// المخرج الأول للتليجرام والمخرج الثاني لقاعدة البيانات\nreturn [telegramMsg, dbMsg];",
