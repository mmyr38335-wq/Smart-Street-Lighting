    {
        "id": "1a8cefbb13cddc97",
        "type": "function",
        "z": "a9a3e6035eb4fb24",
        "name": "Prepare Insert Query",
        "func": "let data = msg.payload;\n\n// التأكد من وجود البيانات وتنسيقها\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch(e) {\n        return null;\n    }\n}\n\nif (data && typeof data.distance !== 'undefined') {\n    msg.topic = `\n      INSERT INTO telemetry (distance, motion, light1, light2, light3, light4, mode)\n      VALUES (\n        ${data.distance},\n        ${data.motion},\n        ${data.light1},\n        ${data.light2},\n        ${data.light3},\n        ${data.light4},\n        '${data.mode}'\n      );\n    `;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
