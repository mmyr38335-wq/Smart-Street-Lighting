    {
        "id": "7fe6dce61510ff53",
        "type": "function",
        "z": "a9a3e6035eb4fb24",
        "name": "Process Mode Change",
        "func": "// التأكد من تحويل النص إلى Object إذا لزم الأمر\nlet data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\nlet newMode = data ? data.mode : null;\n\nif (newMode === \"AUTO\" || newMode === \"MANUAL\") {\n    let mqttMsg = {\n        topic: \"smartstreet/commands/mode\",\n        payload: { mode: newMode }\n    };\n    \n    msg.payload = {\n        success: true,\n        message: \"System mode updated to \" + newMode,\n        mode: newMode\n    };\n    \n    return [msg, mqttMsg];\n} else {\n    msg.statusCode = 400;\n    msg.payload = {\n        success: false,\n        error: \"Invalid mode. Required body: {\\\"mode\\\": \\\"AUTO\\\"} or {\\\"mode\\\": \\\"MANUAL\\\"}\"\n    };\n    return [msg, null];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 1140,
        "wires": [
            [
                "4dfde9802d61171c"
            ],
            [
                "826c25c10b04647d"
            ]
        ]
    },
    {
