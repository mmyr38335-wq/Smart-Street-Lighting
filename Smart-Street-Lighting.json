        "func": "let data = msg.payload;\n\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) { return null; }\n}\n\nif (data && typeof data.distance !== 'undefined') {\n    // إرسال الرقم بشكل مجرد مع تحديد topic واضح للمخطط\n    let msgDistance = { \n        payload: Number(data.distance),\n        topic: \"Distance\"\n    };\n    \n    let msgMode = { \n        payload: String(data.mode) \n    };\n\n    return [msgDistance, msgMode];\n}\n\nreturn null;",
