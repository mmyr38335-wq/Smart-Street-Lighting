    {
        "id": "3d9eb17747a6b42a",
        "type": "function",
        "z": "a9a3e6035eb4fb24",
        "name": "Format Light Command",
        "func": "// لمعرفة المصباح المراد تحكمه بناءً على عنوان الزر\nlet label = msg.ui_control ? msg.ui_control.label : \"\";\nlet lightId = 1;\n\nif (label.includes(\"2\")) lightId = 2;\nif (label.includes(\"3\")) lightId = 3;\nif (label.includes(\"4\")) lightId = 4;\n\nmsg.topic = \"smartstreet/commands/lights\";\nmsg.payload = {\n    light_id: lightId,\n    state: msg.payload\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
