    {
        "id": "aa8926d4cf688b06",
        "type": "function",
        "z": "a9a3e6035eb4fb24",
        "name": "Process Light Control",
        "func": "let data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\nlet lightId = data ? data.light_id : null;\nlet state = data ? data.state : null;\n\nif (lightId >= 1 && lightId <= 4 && (state === 0 || state === 1)) {\n    let mqttMsg = {\n        topic: \"smartstreet/commands/lights\",\n        payload: {\n            light_id: lightId,\n            state: state\n        }\n    };\n    \n    msg.payload = {\n        success: true,\n        message: \"Light \" + lightId + \" set to \" + (state === 1 ? \"ON\" : \"OFF\"),\n        light_id: lightId,\n        state: state\n    };\n    \n    return [msg, mqttMsg];\n} else {\n    msg.statusCode = 400;\n    msg.payload = {\n        success: false,\n        error: \"Invalid parameters. Required: light_id (1-4) and state (0 or 1).\"\n    };\n    return [msg, null];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
